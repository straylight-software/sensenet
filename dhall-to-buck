#!/usr/bin/env bash
# dhall-to-buck - Transpile BUILD.dhall to BUCK
set -euo pipefail

[[ $# -lt 1 ]] && { echo "Usage: $0 <BUILD.dhall>" >&2; exit 1; }

INPUT="$1"

# Handle absolute vs relative paths for dhall imports
if [[ "$INPUT" == /* ]]; then
    DHALL_INPUT="$INPUT"
else
    DHALL_INPUT="./$INPUT"
fi

# Check the structure of the BUILD.dhall file
STRUCTURE=$(dhall type <<< "$DHALL_INPUT" 2>/dev/null || echo "unknown")

# New format: { targets : List Rule }
if [[ "$STRUCTURE" == *"targets"* ]]; then
  # Generate the Starlark rules first
  RULES=$(dhall text <<< "let S = ./dhall/prelude/to-starlark.dhall in S.rules ($DHALL_INPUT).targets")
  
  # Determine which loads are needed based on what rules appear in the output
  # Native rules (cxx_binary, rust_binary, genrule) don't need loads
  # Custom rules (haskell, lean, nv, purescript) come from toolchains
  LOADS=""
  [[ "$RULES" == *"haskell_binary("* || "$RULES" == *"haskell_library("* || "$RULES" == *"haskell_ffi_binary("* ]] && \
    LOADS+=$'load("@toolchains//:haskell.bzl", "haskell_binary", "haskell_library", "haskell_ffi_binary")\n'
  [[ "$RULES" == *"lean_binary("* || "$RULES" == *"lean_library("* ]] && \
    LOADS+=$'load("@toolchains//:lean.bzl", "lean_binary", "lean_library")\n'
  [[ "$RULES" == *"nv_binary("* || "$RULES" == *"nv_library("* ]] && \
    LOADS+=$'load("@toolchains//:nv.bzl", "nv_binary", "nv_library")\n'
  [[ "$RULES" == *"purescript_app("* || "$RULES" == *"purescript_binary("* || "$RULES" == *"purescript_library("* ]] && \
    LOADS+=$'load("@toolchains//:purescript.bzl", "purescript_app", "purescript_binary", "purescript_library")\n'
  [[ "$RULES" == *"nix_cxx_binary("* ]] && \
    LOADS+=$'load("@toolchains//:nix.bzl", "nix_cxx_binary")\n'
  # rust_crate loads - build dynamically based on what's actually used
  CRATE_SYMBOLS=""
  [[ "$RULES" == *"crates_io("* ]] && CRATE_SYMBOLS+="\"crates_io\", "
  [[ "$RULES" == *"http_archive("* ]] && CRATE_SYMBOLS+="\"http_archive\", "
  [[ -n "$CRATE_SYMBOLS" ]] && \
    LOADS+="load(\"@toolchains//:rust_crate.bzl\", ${CRATE_SYMBOLS%, })"$'\n'

  echo "# Generated from $INPUT"
  echo "$LOADS"
  echo "$RULES"
  exit 0
fi

# Legacy format: { rules, header } (pre-generated starlark)
if [[ "$STRUCTURE" == *"rules"* && "$STRUCTURE" == *"header"* ]]; then
  HEADER=$(dhall text <<< "($DHALL_INPUT).header")
  echo "# Generated from $INPUT"
  echo "$HEADER"
  dhall text <<< "let P = ./dhall/prelude/Prelude.dhall in P.Text.concatSep \"\\n\" ($DHALL_INPUT).rules"
  exit 0
fi

# Legacy format: List C.Binary (for backward compat with existing BUILD.dhall files)
DEPS=$(dhall text <<< "(./dhall/prelude/extract-deps.dhall) $DHALL_INPUT" 2>/dev/null || echo "")

if [[ -z "$DEPS" ]]; then
  echo "# Generated from $INPUT"
  echo 'load("@toolchains//:cxx.bzl", "cxx_binary")'
  echo ""
  dhall text <<< "
let S = ./dhall/prelude/to-starlark.dhall
let C = ./dhall/prelude/Cxx.dhall
let t = List/head C.Binary $DHALL_INPUT
in merge { None = \"\", Some = \\(b : C.Binary) -> S.binary b { compiler = [] : List Text, linker = [] : List Text } } t"
  exit 0
fi

FLAGS=$(buck2 run //src/nix-analyze:nix-analyze -- resolve $DEPS 2>/dev/null | grep -v "^\[")

CF="" LF="" next=false
while IFS= read -r f; do
  [[ -z "$f" ]] && continue
  if $next; then CF+="\"$f\", "; next=false
  elif [[ "$f" == "-isystem" ]]; then CF+="\"$f\", "; next=true
  elif [[ "$f" == -I* ]]; then CF+="\"$f\", "
  elif [[ "$f" == -L* || "$f" == -Wl,* || "$f" == -l* ]]; then LF+="\"$f\", "
  fi
done <<< "$FLAGS"

echo "# Generated from $INPUT"
echo "# Deps: ${DEPS//$'\n'/, }"
echo ""
echo 'load("@toolchains//:cxx.bzl", "cxx_binary")'
echo ""
dhall text <<< "
let S = ./dhall/prelude/to-starlark.dhall
let C = ./dhall/prelude/Cxx.dhall
let t = List/head C.Binary $DHALL_INPUT
let f = { compiler = [${CF%,*}], linker = [${LF%,*}] }
in merge { None = \"\", Some = \\(b : C.Binary) -> S.binary b f } t"
