cabal-version:      3.0
name:               sensenet
version:            0.4.0
synopsis:           Pure Haskell build system with content-addressed caching
description:        
    sensenet is a build system that reads typed Dhall configuration,
    executes builds with content-addressed caching (DICE), and produces
    reproducible outputs. No FFI, no daemon, just Haskell.
license:            MIT
author:             Straylight
maintainer:         dev@straylight.ai
category:           Development
build-type:         Simple

executable sensenet
    main-is:          Main.hs
    other-modules:
        SenseNet.Build
        SenseNet.DICE
        SenseNet.Dhall
        SenseNet.Discover
        SenseNet.IR
        SenseNet.Toolchains
    build-depends:
        base >= 4.18 && < 5,
        bytestring,
        containers,
        crypton,
        dhall,
        directory,
        filepath,
        memory,
        process,
        text,
        time
    default-language: GHC2024
    default-extensions:
        LambdaCase
        OverloadedStrings
        OverloadedRecordDot
    ghc-options:
        -Wall
        -Werror
        -O2
        -threaded
        -rtsopts
        "-with-rtsopts=-N"
    hs-source-dirs:   .
