cabal-version:      3.0
name:               sensenet
version:            0.4.0
synopsis:           Pure Haskell build system with content-addressed caching
description:        
    sensenet is a build system that reads typed Dhall configuration,
    executes builds with content-addressed caching (DICE), and produces
    reproducible outputs. No FFI, no daemon, just Haskell.
license:            MIT
author:             Straylight
maintainer:         dev@straylight.ai
category:           Development
build-type:         Simple

executable sensenet
    main-is:          Main.hs
    other-modules:
        DhallFast.Core
        DhallFast.Convert
        DhallFast.Eval
        DhallFast.Input
        SenseNet.Build
        SenseNet.DICE
        SenseNet.Dhall
        SenseNet.Discover
        SenseNet.IR
        SenseNet.PureScript
        SenseNet.RustCrate
        SenseNet.Toolchains
    build-depends:
        aeson,
        async,
        base >= 4.18 && < 5,
        bytestring,
        containers,
        crypton,
        deepseq,
        dhall,
        directory,
        either,
        filepath,
        hashable,
        memory,
        microlens,
        process,
        text,
        text-short,
        time,
        unix,
        unordered-containers,
        vector
    default-language: GHC2024
    default-extensions:
        LambdaCase
        OverloadedStrings
        OverloadedRecordDot
    ghc-options:
        -Wall
        -Werror
        -O2
        -threaded
        -rtsopts
        "-with-rtsopts=-N"
    hs-source-dirs:   .

test-suite sensenet-test
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    other-modules:
        Test.SenseNet.Adversarial
        Test.SenseNet.Build
        Test.SenseNet.Crashers
        Test.SenseNet.DICE
        Test.SenseNet.Integration
        Test.SenseNet.Psychotic
        Test.SenseNet.Savage
        Test.SenseNet.TUI
    build-depends:
        aeson,
        async,
        base >= 4.18 && < 5,
        bytestring,
        containers,
        crypton,
        deepseq,
        directory,
        filepath,
        memory,
        process,
        random,
        tasty,
        tasty-hunit,
        tasty-quickcheck,
        text,
        time,
        unix,
        sensenet
    default-language: GHC2024
    default-extensions:
        LambdaCase
        OverloadedStrings
        OverloadedRecordDot
        RecordWildCards
        ScopedTypeVariables
    ghc-options:
        -Wall
        -Werror
        -threaded
        -rtsopts
        "-with-rtsopts=-N"
    hs-source-dirs:   ../../test

benchmark sensenet-bench
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    build-depends:
        base >= 4.18 && < 5,
        containers,
        criterion,
        deepseq,
        random,
        text
    default-language: GHC2024
    default-extensions:
        LambdaCase
        OverloadedStrings
        RecordWildCards
        ScopedTypeVariables
    ghc-options:
        -Wall
        -O2
        -threaded
        -rtsopts
        "-with-rtsopts=-N"
    hs-source-dirs:   ../../bench
