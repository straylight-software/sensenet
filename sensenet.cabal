cabal-version: 3.0
name:          sensenet
version:       0.1.0
synopsis:      SENSE // NET — Typed builds with Dhall + DICE
description:   sensenet wraps Buck2 with Dhall configuration, running Buck2
               in a namespace with a constructed filesystem view. No Starlark,
               no prelude complexity — just Dhall and DICE.
license:       MIT
author:        straylight
maintainer:    dev@straylight.ai
category:      Build
build-type:    Simple

executable sensenet
  main-is:          Main.hs
  other-modules:
    SenseNet.Config
    SenseNet.DICE
    SenseNet.Dhall
    SenseNet.Discover
    SenseNet.Emit
    SenseNet.Generate
    SenseNet.IR
    SenseNet.Namespace
    SenseNet.Target
  hs-source-dirs:   src/sensenet
  default-language: GHC2024
  ghc-options:      -Wall -O2
  extra-libraries:  dice_ffi
  build-depends:
    , base          >=4.18 && <5
    , bytestring    >=0.11
    , containers    >=0.6
    , dhall         >=1.42
    , directory     >=1.3
    , filepath      >=1.4
    , process       >=1.6
    , shelly        >=1.12
    , text          >=2.0
    , temporary     >=1.3
    , unix          >=2.8
